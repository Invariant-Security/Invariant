# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Python/Python.gitignore
#
# Byte-compiled / cache files
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/

# env file
.env

# Raw artifacts downloaded from sources (see INVARIANT_PRD.md, section 19).
# Metadata sidecars (*.json) are normally regenerated on every fetch (they
# embed a retrieved_at timestamp), so only the PDFs themselves are tracked,
# and only under their CIS OS-family subdirectory (data/raw/cis/debian/,
# data/raw/cis/ubuntu/) -- everything else under data/raw/ stays ignored.
#
# Exception: the 2 sidecars quickdemo.sh's extract/import step actually
# needs (debian_linux_11, ubuntu_linux_20_04) ARE tracked, with a
# repo-root-relative `path` (not absolute) -- extract.py has no fallback to
# derive this metadata from a bare PDF, so without it `invariant extract`
# fails on a fresh clone with no way to regenerate it short of a live CIS
# Workbench fetch. Deliberate exception to the rule above (2026-08-21).
data/raw/*
!data/raw/.gitkeep
!data/raw/cis/
data/raw/cis/*
!data/raw/cis/debian/
!data/raw/cis/ubuntu/
data/raw/cis/debian/*
data/raw/cis/ubuntu/*
!data/raw/cis/debian/*.pdf
!data/raw/cis/ubuntu/*.pdf
!data/raw/cis/debian/cis_debian_linux_11_2.0.0_be3c72ca29c9.json
!data/raw/cis/ubuntu/cis_ubuntu_20_04_3.0.0_55b7089358e1.json

# Editor/IDE
# .idea/
# .vscode/

# Internal onboarding notes — not meant for the public repo.
to-do.md

# quickdemo.sh's per-run misconfig manifest -- regenerated every run (a
# fresh random draw each time), not meant to be committed. See
# scripts/quickdemo/apply_misconfigs.py.
data/quickdemo/
