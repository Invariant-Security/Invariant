# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Python/Python.gitignore
#
# Byte-compiled / cache files
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/

# env file
.env

# Raw artifacts downloaded from sources (see INVARIANT_PRD.md, section 19).
# Metadata sidecars (*.json) are regenerated on every fetch (they embed a
# retrieved_at timestamp), so only the PDFs themselves are tracked, and only
# under their CIS OS-family subdirectory (data/raw/cis/debian/,
# data/raw/cis/ubuntu/) -- everything else under data/raw/ stays ignored.
data/raw/*
!data/raw/.gitkeep
!data/raw/cis/
data/raw/cis/*
!data/raw/cis/debian/
!data/raw/cis/ubuntu/
data/raw/cis/debian/*
data/raw/cis/ubuntu/*
!data/raw/cis/debian/*.pdf
!data/raw/cis/ubuntu/*.pdf

# Editor/IDE
# .idea/
# .vscode/

# Internal onboarding notes — not meant for the public repo.
to-do.md

# quickdemo.sh's per-run misconfig manifest -- regenerated every run (a
# fresh random draw each time), not meant to be committed. See
# scripts/quickdemo/apply_misconfigs.py.
data/quickdemo/
