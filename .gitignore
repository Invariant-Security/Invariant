# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Python/Python.gitignore
#
# Byte-compiled / cache files
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/

# env file
.env

# Raw artifacts downloaded from sources (see INVARIANT_PRD.md, section 19) —
# keep the directory tracked, not its contents.
data/raw/*
!data/raw/.gitkeep

# Editor/IDE
# .idea/
# .vscode/

# Internal onboarding notes — not meant for the public repo.
to-do.md
