# syntax=docker/dockerfile:1
#
# Debian 11 -- hardened base image for demo.sh's live-demo containers
# (invariant-demo-ubuntu-hardened's sibling; invariant-demo-debian-1/2/3 are
# this same image with a couple of misconfigs re-applied on top by
# scripts/demo/apply_misconfigs.py at container start, not at build time).
# Same base image as infra/docker/debian-baseline (debian:11) -- not
# touched, not built from, entirely separate compose file/image name so it
# never collides with the 6 dev/test containers infra/docker-compose.yml
# and tests/assessment/ depend on.
#
# Goal: PASS every CHECK except the handful that are genuinely impossible
# inside an unprivileged Docker container (no bootloader, no functioning
# systemd/journald PID 1, no immutable-flag-capable audit subsystem without
# extra capabilities) -- see docs/architecture/checks.md and
# scripts/demo/misconfig_catalog.py's CONTAINER_IMPOSSIBLE_TITLES for
# exactly which 5 stay FAIL. Confirmed empirically: 187 of 193 CHECKS pass
# on this image, including 4 real packages (ufw/sudo/auditd/aide/cron/
# chrony/libpam-pwquality) whose entire point IS package presence -- there's
# no "pure config" way to pass a package-presence check -- plus a real
# (if unloaded) auditd rule set written to /etc/audit/rules.d/ at build
# time, since the checks that verify audit-rule collection only read that
# file, never a live `auditctl -l`. None of these packages start a service
# (no systemd in this container anyway); they're installed/configured
# purely so `installed_packages`/on-disk config reflect them.
FROM debian:11

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server ufw sudo auditd audispd-plugins aide aide-common \
        cron libpam-pwquality chrony \
    && mkdir -p /run/sshd \
    && rm -rf /var/lib/apt/lists/*

# --- sshd_config: the demo-eligible sshd directives (Groups D/F/L of
# src/invariant/assessment/__init__.py's CHECKS). Values chosen to satisfy
# each evaluator exactly (see that module's evaluate_ssh_* docstrings for
# the real CIS audit condition each one matches) -- e.g. Ciphers/MACs/
# KexAlgorithms deliberately exclude the algorithms each evaluator's own
# _WEAK_*_RE/_WEAK_* set flags, confirmed against a live `sshd -T` run
# during development (see docs/architecture/checks.md). The last 4 lines
# are round 2's Group L additions -- PermitEmptyPasswords/
# HostbasedAuthentication/GSSAPIAuthentication aren't listed because
# OpenSSH's own secure defaults ("no" for all three) already satisfy those
# checks with no directive needed.
RUN cat >> /etc/ssh/sshd_config <<'EOF'
PermitRootLogin no
PermitUserEnvironment no
IgnoreRhosts yes
LoginGraceTime 30
MaxSessions 10
LogLevel VERBOSE
UsePAM yes
DisableForwarding yes
Ciphers aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group14-sha256
MaxStartups 10:30:60
MaxAuthTries 4
ClientAliveInterval 300
ClientAliveCountMax 3
Banner /etc/issue.net
AllowGroups sshusers
EOF

# --- file permissions/ownership: the 15 demo-eligible Group A/D checks.
# /etc/passwd-, /etc/group-, /etc/gshadow-, /etc/motd don't ship on a bare
# debian:11 image (confirmed empirically) -- `touch` creates them without
# clobbering content if a future base image does ship them. SSH host keys
# are generated by openssh-server's postinst above and already come out
# 0600/0644 root:root on both distros (confirmed empirically) -- chmod/
# chown here is just making that explicit/robust rather than load-bearing.
RUN touch /etc/passwd- /etc/group- /etc/gshadow- /etc/shadow- /etc/motd \
    && chmod 644 /etc/issue /etc/issue.net /etc/passwd /etc/passwd- /etc/group /etc/group- /etc/shells /etc/motd \
    && chown root:root /etc/issue /etc/issue.net /etc/passwd /etc/passwd- /etc/group /etc/group- /etc/shells /etc/motd \
    && chmod 640 /etc/shadow /etc/shadow- /etc/gshadow /etc/gshadow- \
    && chown root:shadow /etc/shadow /etc/shadow- /etc/gshadow /etc/gshadow- \
    && chmod 600 /etc/ssh/sshd_config /etc/ssh/ssh_host_*_key \
    && chmod 644 /etc/ssh/ssh_host_*_key.pub \
    && chown root:root /etc/ssh/sshd_config /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub \
    && chmod 700 /etc/cron.d /etc/cron.daily \
    && chown root:root /etc/cron.d /etc/cron.daily \
    && chmod 600 /etc/crontab \
    && chown root:root /etc/crontab \
    && chmod 700 /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly \
    && chown root:root /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly

# --- PAM (common-auth/common-account/common-password) + login.defs: the
# pam_unix/pam_faillock/pam_pwhistory family of demo-eligible checks
# (Groups C/F). Default common-auth ships "pam_unix.so nullok" -- stripped
# below. pam_faillock.so and pam_pwhistory.so are both real files under
# /lib/x86_64-linux-gnu/security/ on this base image (confirmed: no extra
# package needed, unlike pam_pwquality.so -- see checks.md for why pwquality
# module-enabled itself is NOT in the demo-eligible set even though
# pwquality.conf's own directives are).
RUN sed -i 's/pam_unix\.so nullok/pam_unix.so/' /etc/pam.d/common-auth \
    && echo 'auth        required            pam_faillock.so' >> /etc/pam.d/common-auth \
    && echo 'account     required            pam_faillock.so' >> /etc/pam.d/common-account \
    && sed -i 's/pam_unix\.so obscure yescrypt/pam_unix.so obscure yescrypt use_authtok/' /etc/pam.d/common-password \
    && echo 'password    requisite           pam_pwhistory.so' >> /etc/pam.d/common-password \
    && echo 'password    requisite           pam_pwquality.so retry=3' >> /etc/pam.d/common-password \
    && sed -i 's/^UMASK\s.*/UMASK\t\t027/' /etc/login.defs \
    && sed -i 's/^ENCRYPT_METHOD.*/ENCRYPT_METHOD SHA512/' /etc/login.defs \
    && sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS\t365/' /etc/login.defs

# --- su command restricted (round 4/demo hardening): needs one uncommented
# "auth required|requisite pam_wheel.so ... use_uid ... group=<name>" line
# in /etc/pam.d/su, where <name> is a group that exists in /etc/group with
# zero members (confirmed empirically: debian:11's shipped /etc/pam.d/su
# has no uncommented pam_wheel.so line to collide with -- the real
# evaluate() uses the first qualifying line found). A fresh, dedicated
# group (not wheel/sudo, neither guaranteed empty) guarantees this.
RUN groupadd sugroup \
    && echo 'auth       required   pam_wheel.so use_uid group=sugroup' >> /etc/pam.d/su

# --- password failed attempts lockout includes root (round 4/demo
# hardening): /etc/security/faillock.conf doesn't exist on this image at
# all by default (confirmed empirically) -- even_deny_root and/or
# root_unlock_time (0, or >= 60) satisfy the real evaluate() condition.
RUN cat > /etc/security/faillock.conf <<'EOF'
even_deny_root
root_unlock_time = 0
EOF

# --- sudo (round 2 Group L/N/P additions): "Ensure sudo commands use pty"
# needs a `Defaults ... use_pty` line in /etc/sudoers itself (facts.py only
# collects /etc/sudoers, not /etc/sudoers.d/*, matching that evaluator's own
# documented scope limit) -- sudo's own default sudoers doesn't set this.
# "Ensure sudo log file exists" (round 4/demo hardening) needs a
# `Defaults ... logfile=...` line -- the exact path is reused verbatim by
# the audit rule below ("events that modify the sudo log file"), so they
# must stay consistent.
RUN echo 'Defaults        use_pty' >> /etc/sudoers \
    && echo 'Defaults        logfile=/var/log/sudo.log' >> /etc/sudoers

# --- auditd.conf directives (round 4/demo hardening): the package's own
# shipped defaults (confirmed empirically on a fresh install: ROTATE for
# max_log_file_action, SUSPEND for disk_full_action/disk_error_action/
# admin_space_left_action, SYSLOG for space_left_action) don't meet CIS's
# required values for 3 real controls. auditd.conf is simple `key = value`
# text, later line wins on a duplicate key (confirmed via a live install),
# so appending these overrides after the package's own defaults is safe --
# no need to sed the existing lines.
RUN cat >> /etc/audit/auditd.conf <<'EOF'
max_log_file_action = keep_logs
disk_full_action = halt
disk_error_action = syslog
space_left_action = email
admin_space_left_action = halt
EOF

# --- real auditd rules (round 4/demo hardening): the 8 "events ... are
# collected"/"actions ... are logged" controls all read
# facts.audit_rules_text (`cat /etc/audit/rules.d/*.rules
# /etc/audit/audit.rules`), never live `auditctl -l` -- a rules file
# written at build time is sufficient, no running auditd/augenrules
# needed. Every line below was checked against the real evaluate()
# function it satisfies (see src/invariant/assessment/__init__.py's
# "Group: audit rule collection" section): user_emulation (execve+euid!=
# uid), time-change (syscall rule + /etc/localtime watch, both required),
# sudo_log_file (path must match /var/log/sudo.log above), MAC-policy
# (both /etc/apparmor and /etc/apparmor.d must be watched), logins (both
# lastlog and faillock), session (utmp+wtmp+btmp, all three), mounts
# (single line, auid>=UID_MIN), access (two separate lines, one EACCES one
# EPERM). UID_MIN is 1000 on this image (confirmed via /etc/login.defs).
RUN mkdir -p /etc/audit/rules.d \
    && cat > /etc/audit/rules.d/50-hardening.rules <<'EOF'
-a always,exit -F arch=b64 -C euid!=uid -F auid!=unset -S execve -k user_emulation
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-w /etc/localtime -p wa -k time-change
-w /var/log/sudo.log -p wa -k sudo_log_file
-w /etc/apparmor -p wa -k MAC-policy
-w /etc/apparmor.d -p wa -k MAC-policy
-w /var/log/lastlog -p wa -k logins
-w /var/run/faillock -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session
-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k access
-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k access
EOF
# "Ensure audit configuration files mode is configured" scans every
# .conf/.rules file under /etc/audit/ for mode 0640 or stricter --
# confirmed empirically that `cat >` above leaves this file at the
# default 644, which fails that check on its own new file.
RUN chmod 640 /etc/audit/rules.d/50-hardening.rules

# pwquality.conf/pwhistory.conf aren't shipped without libpam-pwquality
# (not installed -- see above), but the CIS controls that grep them (Group
# G) are pure text-file checks independent of whether the enforcing module
# is actually loaded, so writing them by hand is a legitimate config-only
# demo of "what compliant values look like", same as every other file here.
RUN cat > /etc/security/pwquality.conf <<'EOF'
minlen = 14
minclass = 3
maxrepeat = 3
maxsequence = 3
difok = 2
enforce_for_root
EOF
RUN cat > /etc/security/pwhistory.conf <<'EOF'
remember = 24
enforce_for_root
use_authtok
EOF

# --- systemd-timesyncd authorized timeserver (checks-backlog.md Group B):
# /etc/systemd/timesyncd.conf doesn't ship on this image at all (confirmed
# empirically) -- same "config-only demo" pattern as pwquality.conf/
# pwhistory.conf above (the check only reads the file; the daemon that
# would consult it needs a real systemd PID 1, which this container
# doesn't have). NTP/FallbackNTP values are CIS's own documented example
# servers (its audit text's sample "PASS" output names these exact two).
RUN cat > /etc/systemd/timesyncd.conf <<'EOF'
[Time]
NTP=time.nist.gov
FallbackNTP=time-a-g.nist.gov
EOF

CMD ["sleep", "infinity"]
