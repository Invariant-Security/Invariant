# Copy to .env.production (or .env.local) and fill in for a real deploy.
# Vite only exposes variables prefixed VITE_ to client code, and only reads
# .env* files, never process.env -- see https://vite.dev/guide/env-and-mode.

# Base URL of the invariant.api FastAPI app this page talks to. Defaults to
# http://127.0.0.1:8000 (uvicorn's local default) when unset, which is
# right for local dev but not for a remote server.
VITE_API_BASE=https://your-prod-host:8000
