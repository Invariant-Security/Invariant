# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit real credentials.

# CIS WorkBench (workbench.cisecurity.org) account used to log in and
# download gated benchmark PDFs (see docs/decisions/ for why this is needed:
# benchmark discovery works without auth, but the actual PDF download does
# not).
CIS_EMAIL=
CIS_USERNAME=
CIS_PASSWORD=

# PostgreSQL connection (see infra/docker-compose.yml for local dev values).
DATABASE_URL=postgresql://invariant:invariant_dev@localhost:5432/invariant

# Origins invariant.api's CORS allows (comma-separated). Defaults to the
# Vite dev server if unset -- a real deploy sets this to the frontend's
# real public origin. See frontend/README.md's "Deploying" section.
INVARIANT_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
