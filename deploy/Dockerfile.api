FROM python:3.12-slim
WORKDIR /app
COPY . .
# Editable install: main.py/config.py resolve data/ and .env via __file__.parents,
# which only lands on /app when the src/ layout stays intact (see claude_deploy.md).
RUN pip install --no-cache-dir -e .
EXPOSE 8000
CMD ["uvicorn", "invariant.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
